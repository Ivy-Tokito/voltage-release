#!/usr/bin/bash

set -uo pipefail

# ENV
keys_path="$(pwd)/keys"
apex_path="$(pwd)/apex"

# Setup
mkdir -p "${keys_path}"
mkdir -p "${apex_path}"

# Fetch Latest Make_key Scripts From AOSP Source
if [ ! -f ./make_key ]; then
    curl "https://android.googlesource.com/platform/development/+/refs/heads/main/tools/make_key?format=text" | base64 -d >make_key
    sed -i "s/2048/4096/;/Enter password/,+1d" make_key
    chmod +x make_key
fi

# Functions
function generate_overrides_mk() {
    echo "" >>keys.mk

    if [ "${1}" == "apex/apex.list" ]; then
        echo "PRODUCT_CERTIFICATE_OVERRIDES := \\" >>keys.mk
    else
        echo "PRODUCT_CERTIFICATE_OVERRIDES += \\" >>keys.mk
    fi

    cat "${1}" | sed -e '/^[[:space:]]*$/d' | while read -r key; do
        if [[ $key == *":"* ]]; then
            echo "    ${key}.apexkey \\" >>keys.mk
        else
            echo "    ${key}:${key}.apexkey \\" >>keys.mk
        fi
    done

    # Remove trailing `/`
    sed -i '$ s/ \\$//' keys.mk
}

# Platform keys
for x in bluetooth cts_uicc_2021 gmscompat_lib media networkstack nfc platform sdk_sandbox shared testkey; do
    subject="/C=IN/ST=Karnataka/L=Banglore/O=Voltage/OU=${x}/CN=Android/emailAddress=Tokito@android.me"

    ./make_key ./keys/$x "$subject"
    unset subject
done

# APEX keys
cat apex/apex.list | sed -e '/^[[:space:]]*$/d' | while read -r apex; do
    subject="/C=IN/ST=Karnataka/L=Banglore/O=Voltage/OU=${apex}/CN=Android/emailAddress=Tokito@android.me"

    ./make_key "./apex/${apex}" "$subject"
    unset subject
done

# APEX APK keys
cat apex/apex_apk.list | sed -e '/^[[:space:]]*$/d' | cut -d: -f2 | while read -r apex; do
    subject="/C=IN/ST=Karnataka/L=Banglore/O=Voltage/OU=${apex}/CN=Android/emailAddress=Tokito@android.me"

    ./make_key "./apex/${apex}" "$subject"
    unset subject
done

# Generate Files
## Android.bp
echo "// DO NOT EDIT THIS FILE MANUALLY" >Android.bp

# APEX app certificate
cat apex/apex.list apex/apex_apk.list | sed -e '/^[[:space:]]*$/d' | cut -d: -f2 | sort -u | while read -r apex; do
    {
        echo ""
        echo "android_app_certificate {"
        echo "    name: \"${apex}.apexkey\","
        echo "    certificate: \"apex/${apex}\","
        echo "}"
    } >>Android.bp

done

## keys.mk
echo "# DO NOT EDIT THIS FILE MANUALLY" >keys.mk

# APEX keys overrides
generate_overrides_mk apex/apex.list
generate_overrides_mk apex/apex_apk.list

# Platform keys
{
    echo ""
    echo "PRODUCT_DEFAULT_DEV_CERTIFICATE := private-keys/keys/testkey"
    echo "PRODUCT_EXTRA_RECOVERY_KEYS :="
    echo "PRODUCT_CERTIFICATE_GMSCOMPAT_LIB := private-keys/keys/gmscompat_lib"
} >>keys.mk
